<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SimpleSrtEncoder.LoudnessMeterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="#B3000000"
        CornerRadius="6"
        Padding="12,8"
        Margin="12"
        MinWidth="280">
        <Grid>
        <StackPanel x:Name="ContentPanel" Spacing="6">
            <Grid>
                <TextBlock Text="LOUDNESS" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button
                    Content="Reset"
                    HorizontalAlignment="Right"
                    Padding="8,1"
                    FontSize="11"
                    Foreground="White"
                    Background="#33FFFFFF"
                    Click="ResetButton_Click" />
            </Grid>

            <ProgressBar
                x:Name="MomentaryBar"
                Minimum="-50"
                Maximum="0"
                Value="-50"
                Height="8"
                Background="#33FFFFFF" />

            <Canvas x:Name="HistoryCanvas" Height="36" Background="#1AFFFFFF" SizeChanged="HistoryCanvas_SizeChanged">
                <Line x:Name="TargetLine" Stroke="#99FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" />
                <TextBlock x:Name="TargetLabel" Text="-24 LUFS TARGET" Foreground="#99FFFFFF" FontSize="8" />
                <Polyline x:Name="HistoryLine" Stroke="#3FC16E" StrokeThickness="1.5" />
            </Canvas>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MOMENTARY" Foreground="#B3FFFFFF" FontSize="9" />
                    <TextBlock x:Name="MomentaryText" Text="-∞" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="SHORT-TERM" Foreground="#B3FFFFFF" FontSize="9" />
                    <TextBlock x:Name="ShortTermText" Text="-∞" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="INTEGRATED" Foreground="#B3FFFFFF" FontSize="9" />
                    <TextBlock x:Name="IntegratedText" Text="-∞" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="PEAK dBFS" Foreground="#B3FFFFFF" FontSize="9" />
                    <TextBlock x:Name="PeakText" Text="-∞" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border
            x:Name="AwaitingStreamOverlay"
            Background="#CC000000"
            CornerRadius="4"
            Visibility="Collapsed">
            <TextBlock
                Text="Embedded audio only meters once the stream starts"
                Foreground="White"
                FontSize="11"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="16" />
        </Border>
        </Grid>
    </Border>
</UserControl>
