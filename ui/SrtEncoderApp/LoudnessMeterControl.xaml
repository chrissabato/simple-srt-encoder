<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SrtEncoderApp.LoudnessMeterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="#B3000000"
        CornerRadius="6"
        Padding="12,8"
        Margin="12"
        MinWidth="280">
        <StackPanel Spacing="6">
            <Grid>
                <TextBlock Text="LOUDNESS" Foreground="#B3FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button
                    Content="Reset"
                    HorizontalAlignment="Right"
                    Padding="8,1"
                    FontSize="11"
                    Foreground="White"
                    Background="#33FFFFFF"
                    Click="ResetButton_Click" />
            </Grid>

            <ProgressBar
                x:Name="MomentaryBar"
                Minimum="-50"
                Maximum="0"
                Value="-50"
                Height="8"
                Background="#33FFFFFF" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MOMENTARY" Foreground="#B3FFFFFF" FontSize="9" />
                    <TextBlock x:Name="MomentaryText" Text="-∞" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="SHORT-TERM" Foreground="#B3FFFFFF" FontSize="9" />
                    <TextBlock x:Name="ShortTermText" Text="-∞" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="INTEGRATED" Foreground="#B3FFFFFF" FontSize="9" />
                    <TextBlock x:Name="IntegratedText" Text="-∞" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="PEAK dBFS" Foreground="#B3FFFFFF" FontSize="9" />
                    <TextBlock x:Name="PeakText" Text="-∞" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
