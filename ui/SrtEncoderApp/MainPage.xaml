<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SrtEncoderApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SrtEncoderApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <TextBlock Text="SRT Encoder" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="NativeCoreStatusText" Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Page>
