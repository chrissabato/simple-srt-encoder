<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SrtEncoderApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Velopack (see Program.cs) must run before any WinAppSDK/XAML init, which means
         owning Main ourselves instead of the WinUI templates' generated one. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!--
    Velopack's unpackaged distribution needs the Windows App SDK runtime bundled into the
    publish output rather than relying on a separately-installed framework package (which
    is how the MSIX/dotnet-run debug path above gets it).

    REAL BUG, CONFIRMED (2026-10-02): this used to be
    `<PropertyGroup Condition="'$(SelfContained)'=='true'">`, intending to scope it to
    self-contained publishes only (SelfContained=true in win-*.pubxml) — but $(SelfContained)
    is only ever set BY that pubxml, which isn't visible yet when MSBuild evaluates this
    condition against the main project file. The condition silently never matched, so every
    `dotnet publish` (including release.ps1's) produced a framework-dependent build, and the
    installed app crashed on every launch with COMException 0x80040154 (REGDB_E_CLASSNOTREG)
    — confirmed via Windows Event Viewer after a real Velopack install reported "partially
    succeeded". Set unconditionally instead; it's a no-op for the packaged MSIX/dotnet-run
    debug path (that gets the runtime from its MSIX framework package dependency regardless).
  -->
  <PropertyGroup>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
    <!-- DPAPI (ProtectedData) for encrypting SRT passphrases at rest in presets; not
         part of the base BCL on .NET Core/5+, even on Windows-specific TFMs. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- In-app update checking/applying for the unpackaged (non-MSIX) distribution — see
         Program.cs (VelopackApp.Build().Run()) and Services/UpdateService.cs. -->
    <PackageReference Include="Velopack" Version="*" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming disabled: real-hardware testing (2026-10-07) hit a cascading series of
         MissingMethodExceptions from System.Text.Json at runtime on a trimmed +
         WindowsAppSDKSelfContained Release publish — first the built-in
         DateTimeOffsetConverter, then a Utf8JsonWriter method, even after switching to a
         source-generated JsonSerializerContext (supposed to be the trim-safe path) and
         routing it through JsonSerializerOptions.TypeInfoResolver. Each fix just
         surfaced the next missing method rather than converging, indicating a systemic
         incompatibility between the trimmer and System.Text.Json in this specific
         self-contained WindowsAppSDK configuration, not an isolated gap. This is a
         single-user desktop utility, not something where trimmed binary size matters
         enough to justify that fragility — disabling it restores plain, reliable
         reflection-based JSON (see PresetService.cs) at the cost of a larger published
         size. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!--
    Native core (CaptureCore.dll, built from native/ via CMake — see build.ps1 at the repo
    root) is not a project reference; it's included as a Content item so it lands both in
    the plain output directory AND in the AppX staging folder that the single-project MSIX
    packaging step builds for `dotnet run`/packaged launches (a plain post-Build <Copy>
    task reaches the former but not the latter — the packaging step only picks up files
    declared as MSBuild items, not arbitrary files copied by another target).
    NativeCoreBinDir can be overridden, e.g. `dotnet build -p:NativeCoreBinDir=...`, so this
    never depends on a hardcoded absolute path. Evaluated at project-load time against
    whatever's on disk then, which is why build.ps1 always builds native/ before ui/.
  -->
  <PropertyGroup>
    <NativeCorePreset Condition="'$(Configuration)' == 'Debug'">x64-debug</NativeCorePreset>
    <NativeCorePreset Condition="'$(Configuration)' != 'Debug'">x64-release</NativeCorePreset>
    <NativeCoreBinDir Condition="'$(NativeCoreBinDir)' == ''">$(MSBuildThisFileDirectory)..\..\native\build\$(NativeCorePreset)\bin\</NativeCoreBinDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(NativeCoreBinDir)CaptureCore.dll" Condition="Exists('$(NativeCoreBinDir)CaptureCore.dll')">
      <Link>CaptureCore.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NativeCoreBinDir)CaptureCore.pdb" Condition="Exists('$(NativeCoreBinDir)CaptureCore.pdb')">
      <Link>CaptureCore.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="WarnIfNativeCoreMissing" BeforeTargets="Build">
    <Warning Text="CaptureCore.dll not found at $(NativeCoreBinDir) — build native/ first (see build.ps1 at the repo root). The app will run but show a fallback message until then." Condition="!Exists('$(NativeCoreBinDir)CaptureCore.dll')" />
  </Target>

  <!--
    ffmpeg.exe and ffmpeg-legacy-nvenc.exe (fetched by tools/ffmpeg/fetch-ffmpeg.ps1, not
    committed to git — see .gitignore) are bundled as Content when present, so
    `dotnet publish` carries them along. The legacy build exists only as an NVENC
    fallback for GPUs too old for the primary build's NVENC driver requirement — see
    MainViewModel.ResolveEncoder and fetch-ffmpeg.ps1 for why there are two.
    Streaming will fail with a clear error from FfmpegProcessController if the primary
    one is missing; the Condition just keeps the build itself from failing when neither
    has been fetched yet.
  -->
  <ItemGroup>
    <Content Include="ffmpeg\ffmpeg.exe" Condition="Exists('ffmpeg\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ffmpeg\ffmpeg-legacy-nvenc.exe" Condition="Exists('ffmpeg\ffmpeg-legacy-nvenc.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>