# Copy to .env (gitignored) and fill in real values. release.ps1 loads .env
# automatically if present. See release.ps1 -AzureTrustedSignFile's help for where
# these come from.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Needed for -RepoUrl uploads (vpk upload github). A GitHub token with `repo` scope,
# e.g. `gh auth token` if you're already logged in via the GitHub CLI.
GITHUB_TOKEN=
